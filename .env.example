# Copy to .env and fill in. .env is gitignored. Do not commit real credentials.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# AI tactical coach (optional). Without a key the dashboard shows a setup state.
# Default provider is Gemini (config/coach.json). COACH_PROVIDER=anthropic plus
# ANTHROPIC_API_KEY selects Anthropic instead; there is no automatic fallback.
# COACH_MODEL, COACH_EFFORT and COACH_TIMEOUT_S override the config file.
GEMINI_API_KEY=
