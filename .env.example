# Copy to .env and fill in. .env is gitignored. Do not commit real credentials.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# AI tactical coach (optional). Without it the dashboard shows a setup state.
# Provider/model defaults are in config/coach.json; COACH_MODEL, COACH_EFFORT,
# COACH_TIMEOUT_S and COACH_FALLBACKS=off override them.
ANTHROPIC_API_KEY=
